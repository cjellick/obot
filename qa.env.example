# Variable names for the QA credentials file. The real file lives OUTSIDE this repo
# (chmod 600) and the kit only ever reads it by path: export QA_ENV_FILE=/path/to/qa.env
# Format: plain KEY=value lines, no quotes, no `export`, no spaces around `=`. The same file
# is read by `docker run --env-file`, `kubectl create secret --from-env-file` and the shell
# (`set -a; . "$QA_ENV_FILE"; set +a`), so values must not contain spaces, quotes or `$`.
# Leave a value empty (or delete the line) when you don't have it.

# --- Read by the Obot server (passed to the container / pods) ---
# OpenAI key. At startup Obot configures the LLM gateway's `openai` provider with it.
OPENAI_API_KEY=
# Anthropic key. At startup Obot configures the LLM gateway's `anthropic` provider with it.
ANTHROPIC_API_KEY=
# Initial owner's email (Local auth). The kit generates the one-time setup token itself.
OBOT_SERVER_LOCAL_AUTH_INITIAL_OWNER_EMAIL=
# The password the kit's api-login.sh sets for that owner (12+ characters) and logs in with.
OBOT_QA_OWNER_PASSWORD=

# --- Guardrail integrations: NOT read by Obot. Used only by guardrails.sh, which creates
# --- guardrails through the API so keys never go into a UI form.
# Lakera Guard API key (guardrail type `lakera`, field apiKey).
LAKERA_API_KEY=
# Presidio Analyzer base URL, e.g. http://presidio-analyzer:3000 (type `presidio`, analyzerURL).
PRESIDIO_ANALYZER_URL=
# Azure AI Language resource endpoint (type `azure-language-pii`, endpoint).
AZURE_LANGUAGE_ENDPOINT=
# Azure AI Language key (type `azure-language-pii`, apiKey).
AZURE_LANGUAGE_KEY=
# Azure AI Content Safety endpoint (type `azure-content-safety`, endpoint).
AZURE_CONTENT_SAFETY_ENDPOINT=
# Azure AI Content Safety key (type `azure-content-safety`, apiKey).
AZURE_CONTENT_SAFETY_KEY=
# AWS Bedrock Guardrails (type `aws-bedrock`). Prefixed so the AWS SDK in Obot never picks
# them up as Obot's own identity. Access key ID (accessKeyId).
BEDROCK_GUARDRAIL_AWS_ACCESS_KEY_ID=
# Secret access key (secretAccessKey).
BEDROCK_GUARDRAIL_AWS_SECRET_ACCESS_KEY=
# Session token, only for temporary credentials (sessionToken).
BEDROCK_GUARDRAIL_AWS_SESSION_TOKEN=
# Region of the guardrail, e.g. us-east-1 (region).
BEDROCK_GUARDRAIL_REGION=
# Guardrail ID or ARN (guardrailId).
BEDROCK_GUARDRAIL_ID=
# Guardrail version number, or DRAFT (guardrailVersion).
BEDROCK_GUARDRAIL_VERSION=
# Google Cloud Model Armor (type `google-model-armor`). Project ID (project).
GOOGLE_MODEL_ARMOR_PROJECT=
# Template location, e.g. us-central1 (location).
GOOGLE_MODEL_ARMOR_LOCATION=
# Template ID (template).
GOOGLE_MODEL_ARMOR_TEMPLATE=
# PATH to a service account key JSON file with the Model Armor User role (serviceAccountJSON).
GOOGLE_MODEL_ARMOR_SA_KEY_FILE=
# Patronus API key (type `patronus`, apiKey).
PATRONUS_API_KEY=
# CrowdStrike AIDR collector API token (type `crowdstrike-aidr`, apiToken).
CROWDSTRIKE_AIDR_API_TOKEN=
# Optional: https://api.eu-1.crowdstrike.com/aidr/aiguard for the EU cloud (baseURL).
CROWDSTRIKE_AIDR_BASE_URL=
